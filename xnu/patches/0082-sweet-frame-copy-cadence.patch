--- /dev/null
+++ b/iokit/Kernel/arm/SweetFramePacing.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <stdint.h>
+#include <stdbool.h>
+
+/* Nominal software notification frequency, not the panel's DSI mode. */
+#define SWEET_FB_TIMER_HZ 60U
+
+static inline uint32_t
+sweet_fb_copy_rate(uint32_t requested)
+{
+	return requested == 0 || requested > SWEET_FB_TIMER_HZ ?
+	       SWEET_FB_TIMER_HZ : requested;
+}
+
+/* Advance once per software tick, even if no new surface is pending.
+ * phase is initialized to zero and stays below SWEET_FB_TIMER_HZ.
+ * Fractional divisors (e.g. 45/60) keep their requested average cadence.
+ */
+static inline bool
+sweet_fb_copy_due(uint32_t requested, uint32_t *phase)
+{
+	*phase += sweet_fb_copy_rate(requested);
+	if (*phase < SWEET_FB_TIMER_HZ) {
+		return false;
+	}
+	*phase -= SWEET_FB_TIMER_HZ;
+	return true;
+}
